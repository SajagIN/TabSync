{
  "name": "tabsync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "preview": "bun run start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "format": "prettier --write app components hooks lib scripts tests *.ts *.mjs *.json README.md",
    "format:check": "prettier --check app components hooks lib scripts tests *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "geist": "1.8.1",
    "lucide-react": "^0.511.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.0",
    "typescript": "^5.8.0",
    "vitest": "5.0.5"
  }
}
